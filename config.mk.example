# RLK - Custom configuration example
# Copy this file to config.mk and customize as needed

# Compiler settings
CC = cc
CFLAGS = -O0 -g -std=c99 -Wall -Wextra

# For release builds:
# CFLAGS = -O2 -std=c99 -Wall -Wextra

# Determinism contract: never add -ffast-math here. Makefile.inc appends
# -ffp-contract=off (no implicit FMA) after this file, so a custom CFLAGS
# cannot drop it.
